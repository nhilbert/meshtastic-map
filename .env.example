# Copy to .env and adjust. .env is not committed.

# Serial port of your device. Leave empty to auto-detect; a port that no longer exists is skipped.
MESHTASTIC_PORT=COM8

# Where scripts write logs and exports (relative to the project root).
MESHPLAY_DATA_DIR=data

# Position of the home node as "lat,lon", e.g. 50.7374,7.0988: map centre, distances in the
# walk maps, nearest site in the simulation, area of the laser-scan tiles.
MESHPLAY_HOME=

# DEBUG, INFO, WARNING, ERROR
MESHPLAY_LOG_LEVEL=INFO
